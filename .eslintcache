26T09:00:00+08:00\",\n    endTime: \"2026-04-26T09:30:00+08:00\",\n    duration: 30,\n    questions: 12,\n    status: \"graded\",\n    score: 10,\n    total: 12,\n ",[1968,2169],"\n    id: \"e5\",\n    title: \"Final — Full Syllabus\",\n    classId: \"c3\",\n    classCode: \"MA210\",\n    startTime: \"2026-06-18T09:00:00+08:00\",\n    endTime: \"2026-06-18T11:00:00+08:00\",\n    duration: 120,\n    questions: 30,\n    status: \"draft\",\n ",[2176,2397],"\n    id: \"e6\",\n    title: \"Quiz 4 — Hash Tables\",\n    classId: \"c1\",\n    classCode: \"CS201\",\n    startTime: \"2026-05-22T10:00:00+08:00\",\n    endTime: \"2026-05-22T10:30:00+08:00\",\n    duration: 30,\n    questions: 12,\n    status: \"graded\",\n    score: 0,\n    total: 12,\n ",[2694,2843],"\n    id: \"q1\",\n    type: \"MCQ\",\n    text: \"Which traversal visits the root last?\",\n    classCode: \"CS201\",\n    difficulty: \"easy\",\n    points: 2,\n    tags: [\"trees\"],\n    version: 3,\n ",[2850,2994],"\n    id: \"q2\",\n    type: \"MCQ\",\n    text: \"Time complexity of binary search?\",\n    classCode: \"CS201\",\n    difficulty: \"easy\",\n    points: 1,\n    tags: [\"bigO\"],\n    version: 1,\n ",[3001,3149],"\n    id: \"q3\",\n    type: \"TF\",\n    text: \"A B-tree always has balanced height.\",\n    classCode: \"CS305\",\n    difficulty: \"med\",\n    points: 2,\n    tags: [\"indexes\"],\n    version: 2,\n ",[3156,3316],"\n    id: \"q4\",\n    type: \"ESSAY\",\n    text: \"Explain ACID properties with examples.\",\n    classCode: \"CS305\",\n    difficulty: \"hard\",\n    points: 10,\n    tags: [\"transactions\"],\n    version: 1,\n ",[3323,3457],"\n    id: \"q5\",\n    type: \"MCQ\",\n    text: \"Which sort is stable?\",\n    classCode: \"CS201\",\n    difficulty: \"med\",\n    points: 2,\n    tags: [\"sorting\"],\n    version: 1,\n ",[3464,3613],"\n    id: \"q6\",\n    type: \"TF\",\n    text: \"Hash table lookup is O(1) worst-case.\",\n    classCode: \"CS201\",\n    difficulty: \"med\",\n    points: 1,\n    tags: [\"hashing\"],\n    version: 4,\n ",[3620,3771],"\n    id: \"q7\",\n    type: \"ESSAY\",\n    text: \"Compare BFS and DFS, with use cases.\",\n    classCode: \"CS201\",\n    difficulty: \"hard\",\n    points: 8,\n    tags: [\"graphs\"],\n    version: 2,\n ",[4337,4373],"\n    examId: \"e1\",\n    student: \"Aisha Tan\",\n   ",[4420,4458],"\n    total: 20,\n    flags: 0,\n    flagReasons: [],\n   ",[4547,4763],"\n      q7: \"BFS uses a queue and explores level by level — ideal for shortest path in unweighted graphs. DFS uses a stack and goes as deep as possible before backtracking — better for cycle detection and topological sort.\",\n   ",[4789,4826],"\n    examId: \"e1\",\n    student: \"Hafiz Daud\",\n   ",[4875,4896],"\n    total: 20,\n    flags: 2,\n   ",[5071,5071],"\n   ",[5117,5156],"\n    examId: \"e1\",\n    student: \"Priya Suresh\",\n   ",[5203,5241],[5330,5578],"\n      q7: \"BFS explores all neighbors before going deeper using a queue, making it optimal for shortest-path problems. DFS uses a stack and explores as deep as possible first, making it better for maze solving, cycle detection, and topological sorting.\",\n   ",[5604,5639],"\n    examId: \"e1\",\n    student: \"Wei Jian\",\n   ",[5684,5705],"\n    total: 20,\n    flags: 5,\n   ",[6117,6117],[6205,6288],"\n      q7: \"BFS and DFS are both graph traversal algorithms with different approaches...\",\n   ",[6314,6350],"\n    examId: \"e6\",\n    student: \"Aisha Tan\",\n   ",[6395,6416],"\n    total: 12,\n    flags: 4,\n   ",[6748,6748],[7009,7167],"\n    id: \"a1\",\n    classId: \"c1\",\n    author: \"Dr. Faiz\",\n    date: \"2026-05-20\",\n    title: \"Midterm scope released\",\n    body: \"Chapters 1–6. Focus on traversals and graph basics.\",\n ",[7174,7331],"\n    id: \"a2\",\n    classId: \"c1\",\n    author: \"Dr. Faiz\",\n    date: \"2026-05-15\",\n    title: \"Lab moved to LR-204\",\n    body: \"This Thursday's lab is in LR-204, not the usual room.\",\n ",[7338