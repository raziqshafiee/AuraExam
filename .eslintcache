Modal(false)}\n                disabled={isPosting}\n                className=\"text-muted-foreground hover:text-foreground text-xl leading-none\"\n              >\n                ✕\n              ",[60217,60374],"\n              placeholder=\"Title\"\n              value={annTitle}\n              onChange={(e) => setAnnTitle(e.target.value)}\n              className=\"w-full border-2 border-ink rounded-xl px-4 py-3 bg-background\"\n           ",[60399,60586],"\n              rows={4}\n              placeholder=\"What's the news?\"\n              value={annBody}\n              onChange={(e) => setAnnBody(e.target.value)}\n              className=\"w-full border-2 border-ink rounded-xl px-4 py-3 bg-background resize-none\"\n           ",[60664,60757],"\n                onClick={handlePostAnnouncement}\n                disabled={isPosting || !annTitle.trim() || !annBody.trim()}\n              ",[60868,60951],"\n                variant=\"secondary\"\n                onClick={() => setAnnModal(false)}\n                disabled={isPosting}\n              >\n                Cancel\n              ",[61063,61206],"\n          className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40\"\n          onClick={() => {\n            if (!isUploadingNote) setNoteModal(false);\n          }}\n        ",[61222,61353],[61518,61660],"\n                onClick={() => setNoteModal(false)}\n                disabled={isUploadingNote}\n                className=\"text-muted-foreground hover:text-foreground text-xl leading-none\"\n              >\n                ✕\n              ",[61707,61877],"\n              value={noteTitle}\n              onChange={(e) => setNoteTitle(e.target.value)}\n              placeholder=\"Title (required)\"\n              className=\"w-full border-2 border-ink rounded-xl px-4 py-3 bg-background\"\n           ",[61899,62073],"\n              value={noteDesc}\n              onChange={(e) => setNoteDesc(e.target.value)}\n              placeho